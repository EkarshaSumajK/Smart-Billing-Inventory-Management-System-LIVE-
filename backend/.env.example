# Google OAuth Configuration
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# JWT Configuration
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# Email Configuration (Gmail SMTP)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password-here

# MongoDB - Use environment variable in Railway
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority&ssl=true
MONGODB_URI=mongodb+srv://admin:Sambhav%40123@cluster0.sjgksuv.mongodb.net/smartretail?retryWrites=true&w=majority&ssl=true&tlsAllowInvalidCertificates=false&tlsAllowInvalidHostnames=false

# Flask Analytics Service
FLASK_BASE_URL=http://localhost:5001

# Frontend URL
FRONTEND_BASE_URL=http://localhost:5173

# VAPID Keys for Push Notifications
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Resend API
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=your-email@resend.dev
